HTML
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nuka Design Studio</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f7f3ff;
      color: #222;
      line-height: 1.6;
    }

    header {
      background: #5b21b6;
      color: white;
      padding: 25px 20px;
      text-align: center;
    }

    header h1 {
      font-size: 32px;
      margin-bottom: 8px;
    }

    nav {
      margin-top: 15px;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin: 0 8px;
      font-weight: bold;
    }

    .hero {
      text-align: center;
      padding: 70px 20px;
      background: white;
    }

    .hero h2 {
      color: #5b21b6;
      font-size: 38px;
      margin-bottom: 15px;
    }

    .hero p {
      max-width: 650px;
      margin: auto;
      font-size: 18px;
    }

    .button {
      display: inline-block;
      margin-top: 25px;
      background: #5b21b6;
      color: white;
      text-decoration: none;
      padding: 13px 25px;
      border-radius: 8px;
      font-weight: bold;
    }

    section {
      padding: 50px 20px;
      max-width: 1000px;
      margin: auto;
    }

    section h2 {
      text-align: center;
      color: #5b21b6;
      margin-bottom: 30px;
      font-size: 30px;
    }

    .services {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      justify-content: center;
    }

    .card {
      background: white;
      padding: 25px;
      width: 280px;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.08);
      text-align: center;
    }

    .card h3 {
      color: #5b21b6;
      margin-bottom: 10px;
    }

    .portfolio {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
    }

    .work {
      background: white;
      padding: 30px;
      text-align: center;
      border-radius: 12px;
    }

    footer {
      background: #241044;
      color: white;
      text-align: center;
      padding: 30px 20px;
    }

    footer a {
      color: white;
      text-decoration: none;
      font-weight: bold;
    }

    @media (max-width: 600px) {
      .hero h2 {
        font-size: 30px;
      }

      header h1 {
        font-size: 26px;
      }

      nav a {
        display: inline-block;
        margin: 5px;
      }
    }
  </style>
</head>

<body>

<header>
  <h1>NUKA DESIGN STUDIO</h1>
  <p>Creative Design • Digital Solutions</p>

  <nav>
    <a href="#home">Home</a>
    <a href="#services">Services</a>
    <a href="#portfolio">Portfolio</a>
    <a href="#contact">Contact</a>
  </nav>
</header>

<section class="hero" id="home">
  <h2>We Create Designs That Stand Out</h2>

  <p>
    Nuka Design Studio provides creative and professional graphic design
    services for businesses, brands, events and individuals.
  </p>

  <a class="button" href="#contact">Contact Us</a>
</section>

<section id="services">
  <h2>Our Services</h2>

  <div class="services">
    <div class="card">
      <h3>Flyer Design</h3>
      <p>Professional flyers for businesses, events, products and promotions.</p>
    </div>

    <div class="card">
      <h3>Social Media Design</h3>
      <p>Creative graphics designed to make your social media content stand out.</p>
    </div>

    <div class="card">
      <h3>Business Graphics</h3>
      <p>Modern visual designs that help businesses present themselves professionally.</p>
    </div>
  </div>
</section>

<section id="portfolio">
  <h2>Our Portfolio</h2>

  <div class="portfolio">
    <div class="work">
      <h3>Restaurant Design</h3>
      <p>Creative promotional design for a restaurant brand.</p>
    </div>

    <div class="work">
      <h3>Real Estate Design</h3>
      <p>Professional promotional graphics for real estate services.</p>
    </div>

    <div class="work">
      <h3>Business Flyer</h3>
      <p>Modern flyer design created for business promotion.</p>
    </div>
  </div>
</section>

<section id="contact">
  <h2>Let's Work Together</h2>

  <div class="card" style="margin: auto;">
    <p>
      Need a professional flyer or graphic design for your business?
    </p>

    <a class="button" href="https://wa.me/2348117566194">
      WhatsApp Us
    </a>

    <p style="margin-top: 15px;">
      Call / WhatsApp: 08117566194
    </p>
  </div>
</section>

<footer>
  <p>© 2026 Nuka Design Studio</p>
  <p>Creative designs for modern businesses.</p>
</footer>

</body>
</html>
